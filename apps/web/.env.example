# URL of the Gatherly API (server-side Next rewrite target for /api and /uploads).
# In the single-service production proxy, leave as the internal API (default is fine).
API_URL=http://localhost:4000

# Public API origin for browser Socket.IO.
# - Local dev: leave unset (defaults to http://localhost:4000).
# - Single-service Railway: leave unset (same-origin via the public proxy).
# - Split API/web services: set to the public API URL.
NEXT_PUBLIC_API_URL=

# Canonical site URL used for SEO metadata (sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
