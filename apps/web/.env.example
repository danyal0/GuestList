# Internal API target for Next rewrites (single-service loopback).
API_URL=http://127.0.0.1:4000

# Public API origin for browser Socket.IO.
# - Local multi-port dev: http://localhost:4000
# - Single-service Railway: leave unset (same-origin via the public proxy)
NEXT_PUBLIC_API_URL=

# Canonical site URL used for SEO metadata (sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=https://mkeplays-production.up.railway.app

# ── WhatsApp bridge (Next.js App Router routes under /api/whatsapp/*) ──
# Shared secret; must match the bot process (header: x-whatsapp-bot-token).
WHATSAPP_BOT_TOKEN=change-me-to-a-long-random-secret

# Postgres URL (required for /api/whatsapp/* Prisma writes).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mkeplays?schema=public

# Group that owns WhatsApp-created tennis events (cuid from the groups table).
WHATSAPP_DEFAULT_GROUP_ID=

# Optional defaults for CREATE_EVENT when Grok omits fields.
WHATSAPP_DEFAULT_VENUE=
WHATSAPP_DEFAULT_TIMEZONE=UTC
WHATSAPP_DEFAULT_EVENT_DURATION_MINUTES=90
WHATSAPP_DEFAULT_HOUR=10
