# URL of the Gatherly API (server-side proxy target for /api and /uploads).
API_URL=http://localhost:4000

# Public API origin used by the browser for Socket.IO connections.
# Leave unset in local dev (defaults to http://localhost:4000).
NEXT_PUBLIC_API_URL=

# Canonical site URL used for SEO metadata (sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
