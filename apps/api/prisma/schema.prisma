// MKE Plays — enterprise schema
// Conventions:
// - cuid() primary keys (URL-safe, non-enumerable)
// - soft deletes only where recovery matters (users, messages)
// - denormalized counters (memberCount) maintained transactionally
// - full-text search GIN indexes are added via raw SQL in migrations
//   (see migrations/*_fts_indexes) because Prisma cannot express them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum GroupCategory {
  TECHNOLOGY
  SPORTS
  ARTS
  MUSIC
  EDUCATION
  BUSINESS
  HEALTH
  FOOD
  OUTDOORS
  GAMES
  LANGUAGE
  PHOTOGRAPHY
  BOOKS
  FILM
  SCIENCE
  COMMUNITY
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventVisibility {
  PUBLIC
  MEMBERS
}

enum RsvpStatus {
  GOING
  INTERESTED
  WAITLISTED
  DECLINED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  NEW_MEMBER
  MEMBER_APPROVED
  EVENT_REMINDER
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELLED
  RSVP_CONFIRMED
  RSVP_PROMOTED
  MESSAGE_RECEIVED
  COMMUNITY_UPDATE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  REPORT_RESOLVED
  REPORT_CREATED
  SYSTEM_ERROR
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReportTargetType {
  USER
  GROUP
  EVENT
  MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ActivityType {
  SIGNUP
  LOGIN
  GROUP_CREATED
  GROUP_JOINED
  GROUP_LEFT
  EVENT_CREATED
  EVENT_RSVP
  MESSAGE_SENT
  PROFILE_UPDATED
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  bio             String?   @db.Text
  location        String?
  latitude        Float?
  longitude       Float?
  /// E.164 or digits-only phone for login + WhatsApp linking
  phone           String?   @unique
  /// WhatsApp Linked ID local-part (digits from …@lid). Stable identity when phone is hidden.
  whatsappLid     String?   @unique
  role            UserRole  @default(USER)
  interests       String[]  @default([])
  skills          String[]  @default([])
  emailVerifiedAt DateTime?
  googleId        String?   @unique
  appleId         String?   @unique
  /// Hard ban — cannot sign in.
  suspendedAt     DateTime?
  /// Soft moderation — can use the app, but hidden from discovery / search.
  shadowBannedAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  emailTokens          EmailToken[]
  ownedGroups          Group[]                   @relation("GroupOwner")
  memberships          GroupMember[]
  hostedEvents         Event[]                   @relation("EventHost")
  rsvps                Rsvp[]
  sentMessages         Message[]
  conversations        ConversationParticipant[]
  notifications        Notification[]
  follows              Follow[]
  sentFriendRequests   Friendship[]              @relation("FriendRequester")
  receivedFriendRequests Friendship[]            @relation("FriendAddressee")
  blocksCreated        UserBlock[]               @relation("Blocker")
  blocksReceived       UserBlock[]               @relation("Blocked")
  reportsFiled         Report[]                  @relation("Reporter")
  reportsResolved      Report[]                  @relation("Resolver")
  auditLogs            AuditLog[]
  payments             Payment[]
  activities           ActivityLog[]

  @@index([role])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  family       String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// ─────────────────────────── Communities ───────────────────────────

model Group {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @db.Text
  rules       String?       @db.Text
  coverImage  String?
  category    GroupCategory
  ownerId     String
  privacy     GroupPrivacy  @default(PUBLIC)
  memberCount Int           @default(1)
  location    String?
  latitude    Float?
  longitude   Float?
  isVerified  Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner         User           @relation("GroupOwner", fields: [ownerId], references: [id])
  members       GroupMember[]
  events        Event[]
  followers     Follow[]
  conversations Conversation[]
  payments      Payment[]

  @@index([category])
  @@index([privacy])
  @@index([ownerId])
  @@index([memberCount])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("groups")
}

model GroupMember {
  id       String            @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole   @default(MEMBER)
  status   GroupMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
  @@map("group_members")
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("follows")
}

// ─────────────────────────── Venues (standardized places) ───────────────────────────

model Venue {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  /// Sport key, e.g. TENNIS — expand to enum later as we add sports.
  sport      String    @default("TENNIS")
  city       String?
  region     String?
  country    String    @default("US")
  address    String
  latitude   Float?
  longitude  Float?
  aliases    String[]  @default([])
  notes      String?   @db.Text
  /// catalog | ai | user
  source     String    @default("catalog")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  events Event[]

  @@index([sport, city])
  @@index([name])
  @@map("venues")
}

// ─────────────────────────── Events ───────────────────────────

model Event {
  id             String          @id @default(cuid())
  groupId        String
  hostId         String
  venueId        String?
  title          String
  description    String          @db.Text
  coverImage     String?
  mode           EventMode       @default(IN_PERSON)
  locationName   String?
  address        String?
  latitude       Float?
  longitude      Float?
  onlineUrl      String?
  timezone       String          @default("UTC")
  startTime      DateTime
  endTime        DateTime
  /// Prior start before the latest WhatsApp/host reschedule (for strikethrough UI).
  previousStartTime DateTime?
  rescheduledAt  DateTime?
  capacity       Int?
  status         EventStatus     @default(PUBLISHED)
  visibility     EventVisibility @default(PUBLIC)
  allowWaitlist  Boolean         @default(true)
  rsvpDeadline   DateTime?
  recurrenceRule String?
  parentEventId  String?
  /// WhatsApp message id that proposed this match (for reaction-based RSVPs)
  whatsappMessageId String?      @unique
  remindersSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  host        User    @relation("EventHost", fields: [hostId], references: [id])
  venue       Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  parentEvent Event?  @relation("EventRecurrence", fields: [parentEventId], references: [id], onDelete: SetNull)
  occurrences Event[] @relation("EventRecurrence")
  rsvps       Rsvp[]

  @@index([groupId])
  @@index([hostId])
  @@index([venueId])
  @@index([startTime])
  @@index([status, visibility, startTime])
  @@index([latitude, longitude])
  @@map("events")
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status, createdAt])
  @@map("rsvps")
}

// ─────────────────────────── Messaging ───────────────────────────

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  groupId   String?
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([groupId])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────── Social ───────────────────────────

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

/// Peer block — hides social contact (friend requests / friends list) between users.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ─────────────────────────── Notifications ───────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─────────────────────────── Trust & Safety ───────────────────────────

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?          @db.Text
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("Resolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── Payments ───────────────────────────

model Payment {
  id          String        @id @default(cuid())
  userId      String
  groupId     String?
  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("internal")
  providerRef String?
  purpose     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────── Analytics ───────────────────────────

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}
