# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherly?schema=public

# Auth — generate strong secrets in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# OAuth (optional — features degrade gracefully when unset)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Email (SMTP). When unset, emails are logged to stdout (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gatherly <no-reply@gatherly.app>"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Uploads
UPLOAD_MAX_BYTES=5242880
