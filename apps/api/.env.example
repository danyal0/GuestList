# Server
NODE_ENV=development
PORT=4000

# Public site URL (Railway). Used when WEB_URL / API_URL are unset.
PUBLIC_URL=https://mkeplays-production.up.railway.app
API_URL=https://mkeplays-production.up.railway.app
WEB_URL=https://mkeplays-production.up.railway.app
CORS_ORIGINS=https://mkeplays-production.up.railway.app,http://localhost:3000,http://localhost:8080

# Data source: "file" (default mock JSON) or "postgres"
DATA_SOURCE=file
# Only required when DATA_SOURCE=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherly?schema=public

# Auth — generate strong secrets in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=mkeplays-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=mkeplays-dev-refresh-secret-change-me-32b
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=

# OAuth (optional — features degrade gracefully when unset)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Email (SMTP). When unset, emails are logged to stdout (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gatherly <no-reply@gatherly.app>"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Uploads
UPLOAD_MAX_BYTES=5242880
