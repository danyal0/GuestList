# Environment for the WhatsApp bridge (scripts/whatsapp/bot.js)
# On Railway: set these as service Variables (no .env file needed).
# Locally: copy to repo root `.env`.

# Exact WhatsApp group subject to monitor (case-insensitive match).
WHATSAPP_GROUP_NAME=Tennis Group

# Shared secret sent as header `x-whatsapp-bot-token` to Next.js.
# MUST match WHATSAPP_BOT_TOKEN on the web/Railway service.
WHATSAPP_BOT_TOKEN=change-me-to-a-long-random-secret

# Run the bot inside the Railway web/API container (sibling process).
# WHATSAPP_BOT_ENABLED=true

# Base URL the bot POSTs to.
# On Railway (in-process): leave unset → defaults to http://127.0.0.1:3000
# On laptop/VPS: set to your public Railway URL
# APP_BASE_URL=https://mkeplays-production.up.railway.app

# xAI / Grok — https://console.x.ai/
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-4-1-fast-non-reasoning-latest

# Ignore Grok results below this confidence (0–1).
WHATSAPP_MIN_CONFIDENCE=0.6

# LocalAuth session path.
# Railway: mount a volume at /data and keep the default below.
WHATSAPP_CLIENT_ID=gatherly-tennis-bot
WHATSAPP_AUTH_PATH=/data/wwebjs_auth

# System Chromium (Railway railpack installs this).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true

# Optional behaviour toggles
# WHATSAPP_PROCESS_SELF=true
# WHATSAPP_REQUIRE_GROUP_ON_REACTION=true
